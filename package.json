{
  "name": "go-rot",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Scroll while your agent works",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "doctor:claude": "node scripts/doctor.mjs --surface claude",
    "capture:claude": "node scripts/capture-claude-events.mjs",
    "trace:claude": "node scripts/claude-trace.mjs",
    "setup": "node scripts/install.mjs install --all",
    "remove": "node scripts/install.mjs uninstall --all",
    "package:extension": "node scripts/package-extension.mjs",
    "package:release": "node scripts/package-release.mjs",
    "generate:store-assets": "node scripts/generate-store-assets.mjs",
    "benchmark:hook": "node scripts/benchmark-hook.mjs",
    "validate:extension": "node scripts/validate-extension.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
