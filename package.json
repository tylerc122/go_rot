{
  "name": "firsttok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Take a real short-form video break while Claude Code or Codex works.",
  "scripts": {
    "install:mvp": "node scripts/install.mjs install --all",
    "uninstall:mvp": "node scripts/install.mjs uninstall --all",
    "install:alpha": "node scripts/install.mjs install --all",
    "uninstall:alpha": "node scripts/install.mjs uninstall --all",
    "install:alpha:claude": "node scripts/install.mjs install --native && node scripts/install.mjs install --claude",
    "uninstall:alpha:claude": "node scripts/install.mjs uninstall --claude && node scripts/install.mjs uninstall --native",
    "doctor": "node scripts/doctor.mjs",
    "doctor:claude": "node scripts/doctor.mjs --surface claude",
    "capture:claude": "node scripts/capture-claude-events.mjs",
    "trace:claude": "node scripts/claude-trace.mjs",
    "package:alpha": "node scripts/package-alpha.mjs",
    "package:alpha:claude": "node scripts/package-alpha.mjs --surface claude",
    "benchmark:hook": "node scripts/benchmark-hook.mjs",
    "validate:extension": "node scripts/validate-extension.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
