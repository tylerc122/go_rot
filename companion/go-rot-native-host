#!/bin/sh
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -n "$GO_ROT_NODE" ] && [ -x "$GO_ROT_NODE" ]; then
  exec "$GO_ROT_NODE" "$SCRIPT_DIR/native-host.mjs"
fi

for GO_ROT_NODE_CANDIDATE in \
  /opt/homebrew/bin/node \
  /usr/local/bin/node \
  /usr/bin/node
do
  if [ -x "$GO_ROT_NODE_CANDIDATE" ]; then
    exec "$GO_ROT_NODE_CANDIDATE" "$SCRIPT_DIR/native-host.mjs"
  fi
done

exec /usr/bin/env node "$SCRIPT_DIR/native-host.mjs"
