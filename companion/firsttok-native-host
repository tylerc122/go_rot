#!/bin/sh
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -n "$FIRSTTOK_NODE" ] && [ -x "$FIRSTTOK_NODE" ]; then
  exec "$FIRSTTOK_NODE" "$SCRIPT_DIR/native-host.mjs"
fi

for FIRSTTOK_NODE_CANDIDATE in \
  /opt/homebrew/bin/node \
  /usr/local/bin/node \
  /usr/bin/node
do
  if [ -x "$FIRSTTOK_NODE_CANDIDATE" ]; then
    exec "$FIRSTTOK_NODE_CANDIDATE" "$SCRIPT_DIR/native-host.mjs"
  fi
done

exec /usr/bin/env node "$SCRIPT_DIR/native-host.mjs"
