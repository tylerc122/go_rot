{
  "manifest_version": 3,
  "name": "Go Rot",
  "version": "0.1.2",
  "description": "Scroll while your agent works",
  "key": "",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "system.display"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Go Rot",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_ui": {
    "page": "panel.html",
    "open_in_tab": true
  },
  "commands": {
    "return-to-agent": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "Close Go Rot and return to the active agent"
    }
  }
}
